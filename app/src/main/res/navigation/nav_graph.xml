<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.campussync.app.ui.splash.SplashFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_splash" />

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.campussync.app.ui.onboarding.OnboardingFragment"
        android:label="@string/onboarding_title"
        tools:layout="@layout/fragment_onboarding" />

    <fragment
        android:id="@+id/authFragment"
        android:name="com.campussync.app.ui.auth.AuthFragment"
        android:label="@string/title_login"
        tools:layout="@layout/fragment_auth" />

    <fragment
        android:id="@+id/verifyEmailFragment"
        android:name="com.campussync.app.ui.auth.VerifyEmailFragment"
        android:label="@string/verify_email_title"
        tools:layout="@layout/fragment_verify_email" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.campussync.app.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <argument
            android:name="screen"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/eventsFragment"
        android:name="com.campussync.app.ui.events.EventsFragment"
        android:label="@string/nav_events"
        tools:layout="@layout/fragment_events" />

    <fragment
        android:id="@+id/eventDetailFragment"
        android:name="com.campussync.app.ui.events.EventDetailFragment"
        android:label="@string/event_details"
        tools:layout="@layout/fragment_event_detail">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/createEventFragment"
        android:name="com.campussync.app.ui.events.CreateEventFragment"
        android:label="@string/title_host_event"
        tools:layout="@layout/fragment_create_event" />

    <fragment
        android:id="@+id/eventParticipantsFragment"
        android:name="com.campussync.app.ui.events.EventParticipantsFragment"
        android:label="@string/title_participants"
        tools:layout="@layout/fragment_event_participants">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/myEventsFragment"
        android:name="com.campussync.app.ui.events.MyEventsFragment"
        android:label="@string/action_my_events"
        tools:layout="@layout/fragment_my_events" />

    <fragment
        android:id="@+id/noticesFragment"
        android:name="com.campussync.app.ui.events.NoticesFragment"
        android:label="@string/title_notices"
        tools:layout="@layout/fragment_notices" />

    <fragment
        android:id="@+id/groupsFragment"
        android:name="com.campussync.app.ui.groups.GroupsFragment"
        android:label="@string/nav_groups"
        tools:layout="@layout/fragment_groups" />

    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.campussync.app.ui.groups.GroupDetailFragment"
        android:label="Group details"
        tools:layout="@layout/fragment_group_detail">
        <argument
            android:name="groupId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.campussync.app.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.campussync.app.ui.profile.EditProfileFragment"
        android:label="@string/title_edit_profile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.campussync.app.ui.profile.UserProfileFragment"
        android:label="@string/title_public_profile"
        tools:layout="@layout/fragment_user_profile">
        <argument
            android:name="uid"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/verificationFragment"
        android:name="com.campussync.app.ui.verification.VerificationFragment"
        android:label="@string/title_verification"
        tools:layout="@layout/fragment_verification" />

    <fragment
        android:id="@+id/adminVerificationsFragment"
        android:name="com.campussync.app.ui.admin.AdminVerificationsFragment"
        android:label="@string/title_admin_verifications"
        tools:layout="@layout/fragment_admin_verifications" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.campussync.app.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.campussync.app.ui.social.FeedFragment"
        android:label="@string/title_social"
        tools:layout="@layout/fragment_feed" />

    <fragment
        android:id="@+id/createPostFragment"
        android:name="com.campussync.app.ui.social.CreatePostFragment"
        android:label="@string/title_create_post"
        tools:layout="@layout/fragment_create_post">
        <argument
            android:name="postId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="existingContent"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/commentsFragment"
        android:name="com.campussync.app.ui.social.CommentsFragment"
        android:label="@string/title_comments"
        tools:layout="@layout/fragment_comments">
        <argument
            android:name="postId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/storyViewerFragment"
        android:name="com.campussync.app.ui.social.StoryViewerFragment"
        android:label="@string/story_add"
        tools:layout="@layout/fragment_story_viewer">
        <argument
            android:name="storyId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="authorId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/boardsFragment"
        android:name="com.campussync.app.ui.boards.BoardsFragment"
        android:label="@string/title_boards"
        tools:layout="@layout/fragment_boards" />

    <fragment
        android:id="@+id/boardDetailFragment"
        android:name="com.campussync.app.ui.boards.BoardDetailFragment"
        android:label="@string/title_boards"
        tools:layout="@layout/fragment_board_detail">
        <argument
            android:name="boardId"
            app:argType="string" />
        <argument
            android:name="boardName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/discussionDetailFragment"
        android:name="com.campussync.app.ui.boards.DiscussionDetailFragment"
        android:label="@string/title_boards"
        tools:layout="@layout/fragment_discussion_detail">
        <argument
            android:name="boardId"
            app:argType="string" />
        <argument
            android:name="discussionId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/adminReportsFragment"
        android:name="com.campussync.app.ui.admin.AdminReportsFragment"
        android:label="@string/title_admin_reports"
        tools:layout="@layout/fragment_admin_reports" />

    <fragment
        android:id="@+id/conversationsFragment"
        android:name="com.campussync.app.ui.messages.ConversationsFragment"
        android:label="@string/title_messages"
        tools:layout="@layout/fragment_conversations" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.campussync.app.ui.messages.ChatFragment"
        android:label="@string/title_chat"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="conversationId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/userPickerFragment"
        android:name="com.campussync.app.ui.messages.UserPickerFragment"
        android:label="@string/title_new_chat"
        tools:layout="@layout/fragment_user_picker">
        <argument
            android:name="mode"
            android:defaultValue="direct"
            app:argType="string" />
        <argument
            android:name="conversationId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/createGroupFragment"
        android:name="com.campussync.app.ui.messages.CreateGroupFragment"
        android:label="@string/title_new_group"
        tools:layout="@layout/fragment_create_group" />

    <fragment
        android:id="@+id/groupInfoFragment"
        android:name="com.campussync.app.ui.messages.GroupInfoFragment"
        android:label="@string/title_group_info"
        tools:layout="@layout/fragment_group_info">
        <argument
            android:name="conversationId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/blockedUsersFragment"
        android:name="com.campussync.app.ui.messages.BlockedUsersFragment"
        android:label="@string/title_blocked_users"
        tools:layout="@layout/fragment_blocked_users" />

</navigation>
