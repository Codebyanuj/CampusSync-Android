rules_version = '2';

// CampusSync Firestore rules.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Authority model:
//  - `admins/{uid}` documents are created only from the Firebase console / Admin SDK.
//  - Role, account status and verification outcome are server-owned: an owner may read them but
//    never grant them. Only an admin may verify, suspend or change a role.
//  - The client may set its own verification status to `pending`/`unverified` when it submits a
//    request; `verified` and `rejected` are written by an admin only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Restricted attribution for anonymous content: only the author and administrators can
    // read the mapping, and no client query can join public content to its author.
    function anonymousOwner(contentId) {
      return exists(/databases/$(database)/documents/anonymousAuthors/$(contentId))
          && get(/databases/$(database)/documents/anonymousAuthors/$(contentId)).data.ownerId
              == request.auth.uid;
    }

    // A create is attributed either to the signed-in user or to nobody at all (ghost mode).
    function attributedToSelf() {
      return request.resource.data.get('authorId', '') == request.auth.uid
          || (request.resource.data.get('anonymous', false) == true
              && !request.resource.data.keys().hasAny(['authorId']));
    }

    // Privilege fields may never be changed by the owner of the document.
    function serverOwnedFieldsUnchanged() {
      return request.resource.data.get('role', 'student')
              == resource.data.get('role', 'student')
          && request.resource.data.get('accountStatus', 'active')
              == resource.data.get('accountStatus', 'active')
          && request.resource.data.get('verifiedRole', null)
              == resource.data.get('verifiedRole', null)
          && request.resource.data.get('verifiedAt', null)
              == resource.data.get('verifiedAt', null)
          && request.resource.data.get('verifiedBy', null)
              == resource.data.get('verifiedBy', null);
    }

    // The owner may leave the status untouched, or move it to unverified/pending. `verified` and
    // `rejected` are written by an administrator only.
    function verificationNotSelfGranted() {
      return request.resource.data.get('verificationStatus', 'unverified')
              == resource.data.get('verificationStatus', 'unverified')
          || (request.resource.data.get('verificationStatus', 'unverified')
                  in ['unverified', 'pending']
              && resource.data.get('verificationStatus', 'unverified') != 'verified');
    }

    // emailVerified may only become true when Firebase Auth confirms the address.
    function emailVerificationHonest() {
      return request.resource.data.get('emailVerified', false)
              == resource.data.get('emailVerified', false)
          || (request.auth.token.email_verified == true
              && request.resource.data.get('emailVerified', false) == true);
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isSelf(userId)
          && request.resource.data.get('email', '') == request.auth.token.email
          && request.resource.data.get('role', 'student') in ['student', 'faculty']
          && request.resource.data.get('accountStatus', 'active') == 'active'
          && request.resource.data.get('verificationStatus', 'unverified') == 'unverified';

      allow update: if isAdmin() || (
          isSelf(userId)
          && serverOwnedFieldsUnchanged()
          && verificationNotSelfGranted()
          && emailVerificationHonest()
      );

      allow delete: if false;

      // Bookmarks are private to their owner.
      match /bookmarks/{postId} {
        allow read, write: if isSelf(userId);
      }

      // The follow graph is public to signed-in users; only the owner writes their own edges.
      match /following/{targetId} {
        allow read: if signedIn();
        allow write: if isSelf(userId) && userId != targetId;
      }

      // Blocked accounts: private to the blocker and never writable for somebody else.
      match /blocked/{targetId} {
        allow read, write: if isSelf(userId) && userId != targetId;
      }
    }

    // Only the owner may check whether they are an admin; entries are never written by clients.
    match /admins/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /verificationRequests/{requestId} {
      allow read: if signedIn()
          && (isAdmin() || resource.data.get('uid', '') == request.auth.uid);

      allow create: if signedIn()
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('status', 'pending') == 'pending'
          && request.resource.data.get('role', 'student') in ['student', 'faculty'];

      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    // ---------------------------------------------------------------- social feed

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && attributedToSelf()
          && request.resource.data.get('content', '') is string
          && request.resource.data.get('likeCount', 0) >= 0
          && request.resource.data.get('commentCount', 0) >= 0
          && request.resource.data.get('shareCount', 0) >= 0;

      // Owner edits, or counter-only updates from reactions. Ownership of a ghost post is
      // proven through the restricted attribution document, which also covers admins.
      allow update: if signedIn()
          && (
               (resource.data.get('authorId', '') == request.auth.uid)
               || (resource.data.get('anonymous', false) == true
                   && anonymousOwner(postId))
               || request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['likeCount', 'commentCount', 'shareCount', 'updatedAt'])
                   && request.resource.data.get('likeCount', 0) >= 0
                   && request.resource.data.get('commentCount', 0) >= 0
                   && request.resource.data.get('shareCount', 0) >= 0
             )
          || isAdmin();

      allow delete: if isAdmin()
          || (signedIn()
              && (resource.data.get('authorId', '') == request.auth.uid
                  || (resource.data.get('anonymous', false) == true
                      && anonymousOwner(postId))));

      // One like document per user; the id is the user id, so nobody can vote twice.
      match /likes/{userId} {
        allow read: if isSelf(userId);
        allow write: if isSelf(userId);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
            && attributedToSelf()
            && request.resource.data.get('content', '') is string;
        allow update: if isAdmin();
        allow delete: if isAdmin()
            || (signedIn()
                && (resource.data.get('authorId', '') == request.auth.uid
                    || (resource.data.get('anonymous', false) == true
                        && anonymousOwner(commentId))));
      }
    }

    // ---------------------------------------------------------------- stories

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.get('authorId', '') == request.auth.uid;
      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);
      allow delete: if isAdmin()
          || (signedIn() && resource.data.get('authorId', '') == request.auth.uid);

      match /views/{userId} {
        allow read: if isSelf(userId);
        allow write: if isSelf(userId);
      }

      // Replies are read by the story owner and the reply's own author, not by everyone.
      match /replies/{replyId} {
        allow read: if isAdmin()
            || (signedIn()
                && (get(/databases/$(database)/documents/stories/$(storyId)).data.authorId
                        == request.auth.uid
                    || resource.data.get('authorId', '') == request.auth.uid));
        allow create: if signedIn()
            && request.resource.data.get('authorId', '') == request.auth.uid;
        allow update, delete: if isAdmin()
            || (signedIn() && resource.data.get('authorId', '') == request.auth.uid);
      }
    }

    // ---------------------------------------------------------------- message boards

    match /boards/{boardId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.get('createdBy', '') == request.auth.uid
          && request.resource.data.get('name', '') is string;
      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['discussionCount', 'description']);
      allow delete: if isAdmin();

      match /discussions/{discussionId} {
        allow read: if signedIn();
        allow create: if signedIn()
            && attributedToSelf()
            && request.resource.data.get('title', '') is string;
        allow update: if signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['upvoteCount', 'downvoteCount', 'commentCount', 'lastActivityAt'])
            && request.resource.data.get('upvoteCount', 0) >= 0
            && request.resource.data.get('downvoteCount', 0) >= 0;
        allow delete: if isAdmin()
            || (signedIn()
                && (resource.data.get('authorId', '') == request.auth.uid
                    || (resource.data.get('anonymous', false) == true
                        && anonymousOwner(discussionId))));

        match /votes/{userId} {
          allow read: if isSelf(userId);
          allow write: if isSelf(userId);
        }

        match /comments/{commentId} {
          allow read: if signedIn();
          allow create: if signedIn()
              && attributedToSelf()
              && request.resource.data.get('content', '') is string;
          allow update: if isAdmin();
          allow delete: if isAdmin()
              || (signedIn()
                  && (resource.data.get('authorId', '') == request.auth.uid
                      || (resource.data.get('anonymous', false) == true
                          && anonymousOwner(commentId))));
        }
      }
    }

    // Collection-group reads power trending discussions and discussion search.
    match /{path=**}/discussions/{discussionId} {
      allow read: if signedIn();
    }

    // ---------------------------------------------------------------- messaging

    // Online / offline presence: readable by signed-in users, writable only by its owner.
    match /presence/{userId} {
      allow read: if signedIn();
      allow write: if isSelf(userId);
    }

    //
    // A conversation is private to the accounts listed in its members/ subcollection. Rules never
    // trust memberIds on the parent document for access: every read and write needs the caller's
    // own member row, which only that account (or a group admin) can create for them.
    match /conversations/{conversationId} {
      function memberDoc(uid) {
        return /databases/$(database)/documents/conversations/$(conversationId)/members/$(uid);
      }

      function conversationData() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }

      function isMember() {
        return signedIn() && exists(memberDoc(request.auth.uid));
      }

      function isGroupAdmin() {
        return isMember()
            && get(memberDoc(request.auth.uid)).data.get('role', 'member') == 'admin';
      }

      function isDirect() {
        return conversationData().get('type', 'direct') == 'direct';
      }

      // A direct chat is closed in both directions once either participant blocks the other.
      function blockedPair() {
        let partner = conversationData().directA == request.auth.uid
            ? conversationData().directB
            : conversationData().directA;
        return exists(/databases/$(database)/documents/users/$(partner)/blocked/$(request.auth.uid))
            || exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(partner));
      }

      // Preview and unread counters may be updated by any member; nothing else.
      function previewOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastSenderId', 'updatedAt', 'unreadCounts',
          'unreadCounts.' + request.auth.uid
        ]);
      }

      // Leaving: a member may only remove themselves from the membership arrays.
      function selfRemovalOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'memberIds', 'adminIds', 'memberNames', 'memberPhotos', 'memberCount', 'updatedAt'])
            && request.resource.data.memberIds.size() < resource.data.memberIds.size()
            && resource.data.memberIds.toSet()
                   .difference(request.resource.data.memberIds.toSet())
                   .hasOnly([request.auth.uid]);
      }

      allow read: if isMember();

      allow create: if signedIn()
          && request.resource.data.get('ownerId', '') == request.auth.uid
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() >= 2
          && request.resource.data.get('type', 'direct') in ['direct', 'group'];

      allow update: if isMember() && (isGroupAdmin() || previewOnly() || selfRemovalOnly());

      allow delete: if isGroupAdmin() || isAdmin();

      match /members/{userId} {
        allow read: if isMember();

        // The creator writes the first rows of a new thread; afterwards only an admin may add.
        allow create: if isMember()
            && (isSelf(userId)
                || isGroupAdmin()
                || (isDirect() && userId in conversationData().memberIds));

        // A member may only change their own read state; admins manage roles and removals.
        allow update: if isGroupAdmin()
            || (isSelf(userId)
                && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['unreadCount', 'muted', 'lastReadAt']));

        allow delete: if isSelf(userId) || isGroupAdmin();
      }

      match /messages/{messageId} {
        allow read: if isMember();

        allow create: if isMember()
            && request.resource.data.get('senderId', '') == request.auth.uid
            && request.resource.data.get('type', 'text') in
                   ['text', 'image', 'document', 'system']
            && (conversationData().get('type', 'direct') == 'group' || !blockedPair());

        // Read receipts are the only edit a client may make to a message.
        allow update: if isMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);

        allow delete: if isGroupAdmin()
            || request.auth.uid == resource.data.get('senderId', '')
            || isAdmin();
      }

      match /typing/{userId} {
        allow read: if isMember();
        allow write: if isSelf(userId) && isMember();
      }
    }

    // ---------------------------------------------------------------- moderation

    // Restricted attribution. Readable by the author and admins only, so a client cannot
    // discover who wrote anonymous content. Clients may create their own mapping only.
    match /anonymousAuthors/{contentId} {
      allow read: if isAdmin()
          || (signedIn() && resource.data.get('ownerId', '') == request.auth.uid);
      allow create: if signedIn()
          && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow delete: if isAdmin()
          || (signedIn() && resource.data.get('ownerId', '') == request.auth.uid);
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
          && request.resource.data.get('reporterId', '') == request.auth.uid
          && request.resource.data.get('status', 'open') == 'open';
      allow update, delete: if isAdmin();
    }
  }
}
